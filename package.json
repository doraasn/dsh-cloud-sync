{
  "name": "@local/dsh-cloud-sync",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Back up DSH config (skills, plugins, MCP rows, instructions, optional credentials) to any WebDAV server",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
